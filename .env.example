NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://urbis:urbis@localhost:5432/urbis
DB_POOL_MAX=20
REDIS_URL=redis://localhost:6379

# Segurança — use segredos diferentes, aleatórios e >=32 caracteres em staging/produção.
URBIS_TOKEN_SECRET=replace-with-at-least-32-random-characters
URBIS_PII_HMAC_SECRET=replace-with-a-different-32-char-secret
URBIS_ACCESS_TOKEN_TTL_SECONDS=3600
URBIS_CORS_ORIGIN=

# Georreferenciamento / duplicidade / campo
TERRITORY_SNAP_MAX_M=120
DUPLICATE_RADIUS_M=35
DUPLICATE_WINDOW_HOURS=24
FIELD_GEOFENCE_M=250

# Evidência. LOCAL grava em storage/evidence; S3 usa MinIO/S3 compatível.
URBIS_OBJECT_STORE_DRIVER=LOCAL
URBIS_LOCAL_STORAGE_DIR=./storage/evidence
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=urbis-evidence
S3_ACCESS_KEY_ID=urbis
S3_SECRET_ACCESS_KEY=change-me-now
S3_FORCE_PATH_STYLE=true

# Mapas/rotas. A base GIS própria funciona sem Mapbox; rota viária usa Mapbox quando configurado.
MAP_PROVIDER=local
MAPBOX_ACCESS_TOKEN=

# Eventos assíncronos / Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=urbis.domain-events

# Push FCM — forneça JSON da service account somente no worker de notificações.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Observabilidade/erros
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# OIDC/Keycloak (integração opcional; autenticação local continua disponível no alpha)
OIDC_ISSUER_URL=http://localhost:8080/realms/urbis
OIDC_CLIENT_ID=urbis-api
OIDC_AUDIENCE=urbis-api
