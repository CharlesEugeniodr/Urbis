# ====================================
# URBIS Platform — .gitignore
# ====================================

# ---- Environment & Secrets ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- Node.js ----
node_modules/
dist/
build/
.next/
.nuxt/
.output/
.cache/
coverage/
*.tsbuildinfo
.turbo/
.vercel/

# ---- Flutter / Dart ----
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
*.iml
.metadata
pubspec.lock

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
*.egg
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- IDE & Editors ----
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ---- OS Files ----
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ---- Docker (local volumes) ----
docker-data/
postgres-data/

# ---- Storage (local evidence uploads) ----
storage/evidence/*
!storage/evidence/.gitkeep

# ---- Release artifacts (use GitHub Releases) ----
*.zip
*.tar.gz

# ---- Temporary files ----
*.tmp
*.prev
*.bak
*.orig
*.swp
